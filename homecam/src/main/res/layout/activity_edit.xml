<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/back"
            style="@style/HeaderBtn"
            android:contentDescription="กลับ"
            android:text="‹"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="เพิ่มกล้อง"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnScan"
                style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📡  ค้นหากล้องใน Wi-Fi" />

            <TextView style="@style/Label" android:text="ชื่อกล้อง" />
            <EditText
                android:id="@+id/name"
                style="@style/Field"
                android:hint="เช่น หน้าบ้าน, ห้องนั่งเล่น"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="40" />

            <TextView style="@style/Label" android:text="ยี่ห้อ" />
            <Spinner
                android:id="@+id/brand"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_secondary"
                android:lineSpacingMultiplier="1.15"
                android:padding="10dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView style="@style/Label" android:text="IP ของกล้อง (หรือวางลิงก์ rtsp:// เต็ม)" />
            <EditText
                android:id="@+id/host"
                style="@style/Field"
                android:hint="192.168.1.20"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <TextView style="@style/Label" android:text="ชื่อผู้ใช้กล้อง" />
            <EditText
                android:id="@+id/user"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions" />

            <TextView style="@style/Label" android:text="รหัสผ่านกล้อง" />
            <EditText
                android:id="@+id/pass"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnOnvif"
                style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="⚙  ดึงลิงก์อัตโนมัติ (ONVIF)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ขั้นสูง"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView style="@style/Label" android:text="พอร์ต RTSP" />
            <EditText
                android:id="@+id/port"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5" />

            <TextView style="@style/Label" android:text="Path สตรีมหลัก (ชัด)" />
            <EditText
                android:id="@+id/mainPath"
                style="@style/Field"
                android:hint="/stream1"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <TextView style="@style/Label" android:text="Path สตรีมย่อย (ใช้ในหน้ารวม ประหยัดเน็ต) — ไม่ใส่ก็ได้" />
            <EditText
                android:id="@+id/subPath"
                style="@style/Field"
                android:hint="/stream2"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <CheckBox
                android:id="@+id/tcp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ส่งภาพผ่าน TCP (เสถียรกว่าบน Wi-Fi)"
                android:textColor="@color/text" />

            <FrameLayout
                android:id="@+id/previewBox"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tile"
                android:padding="1dp"
                android:visibility="gone">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:show_buffering="never"
                    app:shutter_background_color="#000000"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/muted" />
            </FrameLayout>

            <TextView
                android:id="@+id/testResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTest"
                    style="@style/BtnSecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="ทดสอบ" />

                <Button
                    android:id="@+id/btnSave"
                    style="@style/BtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="บันทึก" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDelete"
                style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ลบกล้องนี้"
                android:textColor="@color/danger"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
